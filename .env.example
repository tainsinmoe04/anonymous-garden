# Local development defaults
GARDEN_ORIGIN=http://127.0.0.1:3001
GARDEN_DEPLOYMENT_MODE=local
GARDEN_NOTIFICATION_WORKER=1
# TELEGRAM_BOT_TOKEN=configure-privately
# TELEGRAM_CHAT_ID=configure-privately
# Optional SMTP fallback (Telegram takes precedence)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=configure-privately
# SMTP_PASSWORD=configure-privately
# SMTP_FROM=configure-privately
# MODERATOR_NOTIFICATION_EMAIL=configure-privately

# Vercel PRODUCTION environment only; do not commit actual values.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
# GARDEN_ORIGIN=https://your-project.vercel.app
# GARDEN_DEPLOYMENT_MODE=hosted
# NEXT_PUBLIC_GARDEN_HOSTED=1
# GARDEN_NOTIFICATION_WORKER=0
# CRON_SECRET=generate-at-least-32-random-characters-privately
